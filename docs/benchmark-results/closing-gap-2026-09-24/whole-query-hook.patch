+// Private experiment hook: never included in the production crate.
+static PROTOTYPE_REVERSE: std::sync::OnceLock<fst::Map<memmap2::Mmap>> = std::sync::OnceLock::new();
+static PROTOTYPE_PATTERN: std::sync::RwLock<Option<(Vec<u8>, Vec<u8>)>> = std::sync::RwLock::new(None);
+pub fn prototype_initialize(path: &std::path::Path) {
+    let file = std::fs::File::open(path).unwrap();
+    PROTOTYPE_REVERSE.set(fst::Map::new(unsafe { memmap2::Mmap::map(&file).unwrap() }).unwrap()).unwrap();
+}
+pub fn prototype_mode(pattern: Option<&str>) {
+    *PROTOTYPE_PATTERN.write().unwrap() = pattern.and_then(|s|s.split_once('*')).map(|(prefix,suffix)| {
+        let mut key=0u32.to_le_bytes().to_vec(); key.extend_from_slice(prefix.as_bytes());
+        (key,suffix.as_bytes().to_vec())
+    });
+}
+fn prototype_upper(prefix: &[u8]) -> Option<Vec<u8>> {
+    let mut upper=prefix.to_vec();
+    let i=upper.iter().rposition(|&b|b!=255)?;upper[i]+=1;upper.truncate(i+1);Some(upper)
+}
