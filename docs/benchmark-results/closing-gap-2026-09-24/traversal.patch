+        "+new +term_start5",
+        "user\\:robert",
+        "\"term start5\"",
+        "\"user robert\"",
+    ] {
+        let query = searcher.query_parser().parse_strict(source).unwrap();
+        let mut count = CountCollector::new();
+        collect_segment(&searcher.segment_readers()[0], query.as_ref(), &mut count)
+            .await
