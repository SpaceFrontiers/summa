@@ -2138,6 +2153,37 @@
 mod tests {
     use std::io::Write;
 
+    #[test]
+    fn dense_accumulator_masks_match_sparse_walk_and_clear_all_scores() {
+        for mask in [
+            0,
+            1,
+            0xff,
+            0xffff,
+            0xffff_ffff,
+            u64::MAX,
+            0x5555_5555_5555_5555,
+            0x8000_0000_0000_0001,
+            0xffff_ffff_ffff_fffe,
+        ] {
+            for word in 0..4 {
+                let mut acc = [0; 256];
+                let mut touched = [0; 4];
+                touched[word] = mask;
+                let mut expected_max = 0;
+                for bit in 0..64 {
+                    if mask & (1 << bit) != 0 {
+                        acc[word * 64 + bit] = bit as u32 * 11;
+                        expected_max = expected_max.max(bit as u32 * 11);
+                    }
+                }
+                assert_eq!(super::max_touched_acc(&acc, &touched), expected_max);
+                super::zero_touched_acc(&mut acc, &touched);
+                assert_eq!(acc, [0; 256]);
+            }
+        }
+    }
