+// Experiment-only clock adapter; the canonical fixture and query paths are unchanged.
+use criterion::measurement::{Measurement, ValueFormatter, WallTime};
+struct CpuTime;
+type CpuCriterion = Criterion<CpuTime>;
+impl CpuTime {
+    fn now() -> std::time::Duration {
+        let mut time = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+        assert_eq!(unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut time) }, 0);
+        std::time::Duration::new(time.tv_sec as u64, time.tv_nsec as u32)
+    }
+}
+impl Measurement for CpuTime {
+    type Intermediate = std::time::Duration;
+    type Value = std::time::Duration;
+    fn start(&self) -> Self::Intermediate { Self::now() }
+    fn end(&self, start: Self::Intermediate) -> Self::Value { Self::now() - start }
+    fn add(&self, a: &Self::Value, b: &Self::Value) -> Self::Value { *a + *b }
+    fn zero(&self) -> Self::Value { std::time::Duration::ZERO }
+    fn to_f64(&self, value: &Self::Value) -> f64 { value.as_nanos() as f64 }
+    fn formatter(&self) -> &dyn ValueFormatter { static WALL: WallTime = WallTime; WALL.formatter() }
+}
