+    // Build every ring before starting consumers; no partial live service on error.
+    let reactors = (0..2)
+        .map(|_| Reactor::new(counters.clone()))
+        .collect::<io::Result<Vec<_>>>()?;
+    let mut workers = Vec::with_capacity(2);
+    for reactor in reactors {
+        let reads = receiver.clone();
+        match super::spawn_worker(
+            "summa-payload-uring",
+            receiver.clone(),
+            counters.clone(),
+            admission.clone(),
+            move || reactor.run(reads),
+        ) {
+            Ok(worker) => workers.push(worker),
+            Err(error) => {
+                receiver.close();
+                admission.close();
+                for worker in workers {
+                    let _ = worker.join();
+                }
+                return Err(error);
+            }
+        }
+    }
+    Ok(workers)
