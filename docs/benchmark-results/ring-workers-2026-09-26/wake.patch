+
+const WAKE_TOKEN: u64 = u64::MAX;
+pub(super) struct Wake(OwnedFd);
+impl Wake {
+    pub(super) fn new() -> io::Result<Self> {
+        let fd = unsafe { libc::eventfd(0, libc::EFD_NONBLOCK | libc::EFD_CLOEXEC) };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: newly created descriptor; this owner closes it exactly once.
+        Ok(Self(unsafe { OwnedFd::from_raw_fd(fd) }))
+    }
+    fn transfer(&self, write: bool) -> io::Result<()> {
+        let mut count = 1u64;
+        for _ in 0..8 {
+            // SAFETY: one live u64, valid owned nonblocking eventfd. No pointer
+            // escapes this syscall; read drains the counter, write increments it.
+            let result = unsafe {
+                if write {
+                    libc::write(self.0.as_raw_fd(), (&count as *const u64).cast(), 8)
+                } else {
+                    libc::read(self.0.as_raw_fd(), (&mut count as *mut u64).cast(), 8)
+                }
+            };
+            if result == 8 {
+                return Ok(());
+            }
+            let error = io::Error::last_os_error();
+            if error.kind() == io::ErrorKind::WouldBlock {
+                return Ok(());
+            }
+            if error.kind() != io::ErrorKind::Interrupted {
+                return Err(error);
+            }
+        }
+        Err(io::Error::new(
+            io::ErrorKind::Interrupted,
+            "eventfd repeatedly interrupted",
+        ))
+    }
+    pub(super) fn notify(&self) -> io::Result<()> {
+        self.transfer(true)
+    }
+    fn drain(&self) -> io::Result<()> {
+        self.transfer(false)
+    }
+}
 
