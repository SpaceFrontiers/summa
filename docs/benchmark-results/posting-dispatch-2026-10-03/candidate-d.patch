+                let left: Vec<_> = (0..128).map(|i| base + i * left_gap).collect();
+                let right: Vec<_> = (0..128).map(|i| base + i * right_gap).collect();
+                for len in [0, 1, 3, 4, 7, 8, 15, 16, 31, 32, 127, 128] {
+                    let (left, right) = (&left[..len], &right[..len]);
+                    for (start_a, start_b) in [(0, 0), (len / 3, len / 2)] {
+                        let expected: Vec<_> = (start_a..len)
+                            .filter_map(|a| {
+                                right[start_b..]
+                                    .binary_search(&left[a])
+                                    .ok()
+                                    .map(|b| (a as u8, (start_b + b) as u8))
