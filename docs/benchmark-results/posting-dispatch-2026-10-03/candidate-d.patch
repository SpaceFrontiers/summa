+#[cfg(target_arch = "x86_64")]
+#[inline]
+fn balanced_posting_suffixes(left: &[u32], a: usize, right: &[u32], b: usize) -> bool {
+    let (nl, nr) = (left.len() - a, right.len() - b);
+    if nl < 16 || nr < 16 {
+        return false;
+    }
+    // Inputs have at most 128 IDs, so even full u32 spans fit these products.
+    let ls = (u64::from(left[left.len() - 1] - left[a]) + 1) * nr as u64;
+    let rs = (u64::from(right[right.len() - 1] - right[b]) + 1) * nl as u64;
+    ls <= rs * 2 && rs <= ls * 2
+}
