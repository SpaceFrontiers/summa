+#[inline]
+#[cfg(any(target_arch = "x86_64", target_arch = "aarch64"))]
+fn equal_mask_4(values: &[u32; 4], doc: u32) -> u32 {
+    #[cfg(target_arch = "x86_64")]
+    {
+        use std::arch::x86_64::*;
+        // SAFETY: SSE2 is an x86_64 baseline feature; the input has four lanes.
+        unsafe {
+            return _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpeq_epi32(
+                _mm_loadu_si128(values.as_ptr().cast()), _mm_set1_epi32(doc as i32),
+            ))) as u32;
+        }
+    }
+    #[cfg(target_arch = "aarch64")]
+    {
+        use std::arch::aarch64::*;
+        // SAFETY: the dispatcher checked NEON and both arrays have four lanes.
+        unsafe {
+            let mask = vceqq_u32(vld1q_u32(values.as_ptr()), vdupq_n_u32(doc));
+            let weights = [1, 2, 4, 8];
+            return vaddvq_u32(vandq_u32(mask, vld1q_u32(weights.as_ptr())));
+        }
+    }
+    #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+    values.iter().enumerate().fold(0, |bits, (i, &v)| bits | (u32::from(v == doc) << i))
 }
 
