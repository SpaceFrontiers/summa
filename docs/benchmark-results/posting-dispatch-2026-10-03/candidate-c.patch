+// Additional format-preserving candidates; exact matches always verify full IDs.
+#[cfg(target_arch="x86_64")]
+#[inline]
+fn intersect_posting_blocks_galloping(l:&[u32],a:&mut usize,r:&[u32],b:&mut usize,out:&mut[(u8,u8)])->usize {
+    let(mut i,mut j,mut n)=(*a,*b,0);
+    while i<l.len() && j+8<=r.len() && n<out.len() {
+        let key=l[i];let groups=(r.len()-j)/8;
+        if r[j+7]<key {
+            let(mut lo,mut hi)=(0,1);
+            while hi<groups && r[j+hi*8+7]<key {lo=hi+1;hi=hi*2+1;}
+            let mut upper=(hi+1).min(groups);
+            while lo<upper {let mid=(lo+upper)/2;if r[j+mid*8+7]<key{lo=mid+1;}else{upper=mid;}}
+            j+=lo*8;
+            if j+8>r.len(){break;}
+        }
+        let group:&[u32;8]=r[j..j+8].try_into().unwrap();
+        if let Some(lane)=equal_lane_8(group,key){out[n]=(i as u8,(j+lane) as u8);n+=1;if n==out.len(){i+=1;j+=lane+1;break;}}
+        i+=1;
+    }
+    *a=i;*b=j;n+intersect_posting_block_groups(l,a,r,b,&mut out[n..])
+}
