+/// Estimate the suffixes' mean-gap ratio without floating point. This is a
+/// cost hint only; both kernels preserve the same ordinal-pair contract.
+#[inline]
+#[cfg(any(target_arch = "x86_64", target_arch = "aarch64"))]
+fn balanced_posting_suffixes(left: &[u32], a: usize, right: &[u32], b: usize) -> bool {
+    let (nl, nr) = (left.len() - a, right.len() - b);
+    if nl < 16 || nr < 16 {
+        return false;
+    }
+    let ls = (u64::from(left[left.len() - 1] - left[a]) + 1) * nr as u64;
+    let rs = (u64::from(right[right.len() - 1] - right[b]) + 1) * nl as u64;
+    ls <= rs * 2 && rs <= ls * 2
+}
+
+/// Compare four IDs on each side, advancing every exhausted group. The
+/// caller has established SIMD availability; no load exceeds its four lanes.
+#[cfg(any(target_arch = "x86_64", target_arch = "aarch64"))]
+#[inline(always)]
+fn intersect_posting_blocks_balanced(
+    left: &[u32], a: &mut usize, right: &[u32], b: &mut usize,
+    pairs: &mut [(u8, u8)],
+) -> usize {
+    let (mut i, mut j, mut count) = (*a, *b, 0);
+    while i + 4 <= left.len() && j + 4 <= right.len() && count < pairs.len() {
+        let (lm, rm) = (left[i + 3], right[j + 3]);
+        for lane in 0..4 {
+            let group: &[u32; 4] = right[j..j + 4].try_into().unwrap();
+            let mask = equal_mask_4(group, left[i + lane]);
+            if mask != 0 {
+                let matched = j + mask.trailing_zeros() as usize;
+                pairs[count] = ((i + lane) as u8, matched as u8);
+                count += 1;
+                if count == pairs.len() {
+                    *a = i + lane + 1;
+                    *b = matched + 1;
+                    return count;
+                }
+            }
+        }
+        i += 4 * usize::from(lm <= rm);
+        j += 4 * usize::from(rm <= lm);
+    }
+    *a = i;
+    *b = j;
+    count + intersect_posting_block_groups(left, a, right, b, &mut pairs[count..])
+}
