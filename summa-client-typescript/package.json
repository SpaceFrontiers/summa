{
  "name": "summa-client-typescript",
  "version": "2.2.5",
  "description": "TypeScript client for Summa search server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "bash generate_proto.sh",
    "build": "tsc",
    "test": "pnpm run build && node --test tests/*.test.cjs",
    "check": "pnpm test",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "search",
    "full-text-search",
    "grpc",
    "summa",
    "vector-search"
  ],
  "license": "MIT",
  "author": "izihawa",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpaceFrontiers/summa",
    "directory": "summa-client-typescript"
  },
  "homepage": "https://github.com/SpaceFrontiers/summa",
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@grpc/grpc-js": "^1.14.7",
    "nice-grpc": "^2.1.18",
    "nice-grpc-client-middleware-deadline": "^2.0.21"
  },
  "devDependencies": {
    "grpc-tools": "^1.13.1",
    "ts-proto": "^2.18.4",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.6.5",
      "@protobufjs/utf8": "^1.1.2",
      "tar": "^7.5.20"
    }
  }
}
