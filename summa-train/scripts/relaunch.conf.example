# Trusted Bash configuration for scripts/relaunch.sh.
# Keep credentials out of this file; point SUMMA_TRAIN_WANDB_ENV at a mode-600
# file containing `WANDB_API_KEY=...` and the non-secret W&B run settings.

SUMMA_TRAIN_OUTPUT=/opt/summa-run/checkpoint
SUMMA_TRAIN_STATE_DIR=/opt/summa-run/relaunch-state
SUMMA_TRAIN_REMOTE_URL=gs://example-training-bucket/retriever-300m-moe

# `--output` and `--resume` are owned by relaunch.sh and must not appear here.
# This supervisor wraps the built-in wake trainer, including periodic sleep for
# a memory-enabled MAL when the command also supplies the two pinned runtime
# arguments below. Lifecycle-only phases use `run-workflow` under their service
# supervisor.
SUMMA_TRAIN_COMMAND=(
  /opt/summa-run/bin/summa-train
  train
  --config /opt/summa-run/retriever_300m_moe.mal
  --tokenizer /opt/summa-run/tokenizer.json
  --workflow /opt/summa-run/workflow.wake.json
  --checkpoint-every 500
  # --sleep-runtime /opt/summa-run/sleep-runtime.json
  # --sleep-runtime-sha256 sha256:replace-with-the-runtime-file-digest
)
# The supervisor runs `<binary> verify-checkpoint` before trusting any local or
# downloaded generation. This defaults to SUMMA_TRAIN_COMMAND[0]; set it only
# when the training command starts through a wrapper such as `env` or `cargo`.
# SUMMA_TRAIN_CHECKPOINT_VERIFIER_BIN=/opt/summa-run/bin/summa-train

# A failed trainer is resumed indefinitely by default. Set a positive value to
# stop after that many retries so a boot-time service can apply its own policy.
SUMMA_TRAIN_RESTART_DELAY=30
SUMMA_TRAIN_MAX_RESTARTS=0

# The referenced immutable generations/sha256-*/ directory and the exact
# generated-artifact closure derived from its sealed training-state.json are
# uploaded and verified before current.json is published last. Artifact payloads
# are deduplicated in checkpoint-objects/sha256/ and each generation has an
# immutable checkpoint-artifacts/<generation>/artifact-manifest.json. Keep all
# paths supplied by SUMMA_TRAIN_COMMAND stable across machine replacements so the
# verified closure can be restored to the same semantic roots. A configured
# external Dreaming initial_policy is deployment-owned and must exist at its
# pinned path with the same digest after replacement. Remote current.json binds
# the closure plus the exact committed metric prefix at
# checkpoint-metrics/<generation>/metrics.jsonl; compare-and-swap publication
# cannot rewind steps and rejects equal-step generation forks. The interval also
# controls retries after a cloud error.
SUMMA_TRAIN_SYNC_INTERVAL=900

# Install W&B once in this virtual environment; relaunch.sh deliberately never
# installs packages or prints credentials during a boot.
SUMMA_TRAIN_WANDB_ENV=/opt/summa-run/wandb.env
SUMMA_TRAIN_WANDB_PYTHON=/opt/summa-run/wandb-venv/bin/python

# Example /opt/summa-run/wandb.env (chmod 600):
# WANDB_API_KEY=replace-me
# WANDB_ENTITY=space-frontiers
# WANDB_PROJECT=summa-retriever
# WANDB_NAME=retriever-300m-moe
# WANDB_RUN_ID=retriever-300m-moe-workflow-v2
